# Copié tel quel dans .output/public/ par nuxt generate, puis déployé par rsync.
# Quatre rôles seulement : HTTPS, DirectoryIndex, cache long sur les assets
# hashés, et aucun fichier caché servi (dont le marqueur .preprod-cible).

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RedirectMatch 404 "/\."

DirectoryIndex index.html

<IfModule mod_headers.c>
  # Tous les assets aux noms hashés : variantes d'images et bundles Nuxt.
  <FilesMatch "\.(avif|webp|js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
